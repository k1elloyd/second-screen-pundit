# Copy to .env; never commit local environment values. No keys go here: Azure access is
# keyless (DefaultAzureCredential locally after `az login`, the managed identity in Azure).

# ---- Local run (.env, read by the app) ----
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
MODEL_FAST=<fast-deployment-name>
MODEL_DEEP=<deep-deployment-name>
SPEECH_ENDPOINT=https://<custom-speech-subdomain>.cognitiveservices.azure.com/
SPEECH_REGION=<speech-resource-region>
# MAI voices need a Speech resource in a MAI region (for example swedencentral).
# The fallback voice is tried once, on the same endpoint, when the main voice fails.
SPEECH_VOICE=en-GB-Harry:MAI-Voice-2.1-Flash
SPEECH_FALLBACK_VOICE=en-GB-RyanNeural

# Optional live-commentary tuning; the values shown are the defaults.
# NARRATIVE_MODE=live
# BROADCAST_DELAY_SECONDS=10
# STREAM_CONNECT_DEADLINE_SECONDS=10
# STREAM_MAX_SECONDS=200
# STREAM_RECONNECT_GRACE_SECONDS=30
# STREAM_PAUSED_GRACE_SECONDS=600
# TACTICAL_COOLDOWN_MINUTES=10
# COMMENTATOR_REASONING_EFFORT=low
# QUESTIONS_PER_MINUTE=6
# QUESTIONS_PER_ADDRESS_PER_MINUTE=20
# MAX_CONCURRENT_REPLAYS=6
# MODEL_CALLS_PER_DAY=900
# TTS_CHARACTERS_PER_DAY=45000

# ---- Azure deployment (azd environment, not this file) ----
# Set each with `azd env set NAME value` before `azd up`. The template deploys into an
# existing resource group and references an existing Foundry account and Speech resource;
# it never creates them, so every "required" value must name something that already exists.
#
# Required:
#   EXISTING_FOUNDRY_ACCOUNT_NAME     Foundry (AIServices) account with the model deployment
#   EXISTING_FOUNDRY_RESOURCE_GROUP   its resource group (same subscription)
#   FOUNDRY_PROJECT_NAME              the Foundry project on that account
#   EXISTING_SPEECH_ACCOUNT_NAME      Speech resource with a custom subdomain, in a MAI-voice
#                                     region for the default voice
#   AZURE_RESOURCE_GROUP              the resource group to deploy into; the preprovision hook
#                                     sets it to rg-<environment name> when unset, and stops if
#                                     that group doesn't exist (create it first)
#   (azd also asks for AZURE_SUBSCRIPTION_ID and AZURE_LOCATION on first use; the template
#    deploys to UK South whatever AZURE_LOCATION says)
#
# Optional (defaults shown):
#   EXISTING_SPEECH_RESOURCE_GROUP=   empty means the deployment's resource group
#   MODEL_FAST=gpt-5.4-mini           deployment names on the Foundry account
#   MODEL_DEEP=gpt-5.4-mini
#   SPEECH_VOICE=en-GB-Harry:MAI-Voice-2.1-Flash
#   SPEECH_FALLBACK_VOICE=en-GB-RyanNeural
#   NARRATIVE_MODE=live               live | cached | off; off is the kill switch (no model calls)
#   MIN_REPLICAS=1                    1 keeps the app warm; 0 scales to zero when idle
#   MODEL_CALLS_PER_DAY=900           daily caps (UTC); reaching one sends new viewers to
#   TTS_CHARACTERS_PER_DAY=45000      cached mode with audio off; 0 forces cached mode
#
# There is no "create a new Foundry account" path: leaving the Foundry or Speech names empty
# fails the deployment.
